{
    "name": "diskarte",
    "version": "2.8.0",
    "private": true,
    "description": "Diskarte by MakinaLabs: marine engineer simulators for Android and Windows",
    "scripts": {
        "web": "node src/purifier/build.js && node scripts/build-web.js",
        "sync": "npm run web && npx cap sync android",
        "desktop": "npm run web && electron .",
        "dist:win": "npm run web && electron-builder --win --x64"
    },
    "devDependencies": {
        "@capacitor/android": "^8.6.0",
        "@capacitor/cli": "^8.6.0",
        "@capacitor/core": "^8.6.0",
        "@fontsource/barlow": "^5.3.0",
        "@fontsource/barlow-condensed": "^5.3.0",
        "@fontsource/share-tech-mono": "^5.3.0",
        "electron": "^37.10.3",
        "electron-builder": "^26.18.0",
        "esbuild": "^0.28.2",
        "three": "^0.187.0"
    },
    "main": "electron/main.cjs",
    "author": "MakinaLabs",
    "build": {
        "appId": "io.github.tsogs66.diskarte",
        "productName": "Diskarte",
        "directories": {
            "output": "release"
        },
        "files": [
            "electron/**",
            "www/**",
            "package.json"
        ],
        "win": {
            "target": [
                "portable",
                "dir"
            ],
            "icon": "electron/icon.png",
            "artifactName": "Diskarte-${version}-${arch}.${ext}"
        }
    },
    "allowScripts": {
        "electron@37.10.3": true,
        "esbuild@0.28.2": true,
        "electron-winstaller@5.4.0": true
    }
}
